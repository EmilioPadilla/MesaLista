# Production bundle env. EAS Build injects these from the `production` profile
# in eas.json, but a local Xcode archive never reads eas.json — Metro inlines
# EXPO_PUBLIC_* at bundle time from this file instead (Release => NODE_ENV
# production => .env.production). Keep in sync with eas.json.
EXPO_PUBLIC_API_URL=https://www.mesalista.com.mx/api
EXPO_PUBLIC_WEB_URL=https://mesalista.com.mx
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_BDYkCgXwXyHJKBmmEUDedhdzXxo
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=fixed_plan
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default
