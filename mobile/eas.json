{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.mesalista.com.mx/api",
        "EXPO_PUBLIC_WEB_URL": "https://mesalista.com.mx"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.mesalista.com.mx/api",
        "EXPO_PUBLIC_WEB_URL": "https://mesalista.com.mx"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
